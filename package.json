{
  "name": "nerve-ending",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-first archival investigation inside Meridian Systems.",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "preview": "node scripts/serve.mjs",
    "model:prepare": "node scripts/prepare-language-model.mjs",
    "model:references": "node scripts/evaluate-language-model.mjs --write-embeddings",
    "model:evaluate": "node scripts/evaluate-language-model.mjs",
    "model:holdout": "node scripts/evaluate-language-model.mjs --holdout",
    "model:catalogue": "node scripts/evaluate-language-model.mjs --catalogue",
    "model:verify": "node scripts/verify-language-assets.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@huggingface/transformers": "3.8.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
