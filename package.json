{
  "name": "nerve-ending",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-first archival investigation inside Meridian Systems.",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /nerve-ending-project/ && node scripts/validation/validate-pages-artifact.mjs",
    "pages:validate": "node scripts/validation/validate-pages-artifact.mjs",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "structure:check": "node scripts/validation/validate-structure.mjs",
    "game:validate": "node scripts/validation/validate-game.mjs",
    "preview": "node scripts/preview/serve.mjs",
    "model:prepare": "node scripts/model/prepare-language-model.mjs",
    "model:references": "node scripts/model/evaluate-language-model.mjs --write-embeddings",
    "model:evaluate": "node scripts/model/evaluate-language-model.mjs",
    "model:holdout": "node scripts/model/evaluate-language-model.mjs --holdout",
    "model:continuation": "node scripts/model/evaluate-language-model.mjs --continuation",
    "model:catalogue": "node scripts/model/evaluate-language-model.mjs --catalogue",
    "model:verify": "node scripts/model/verify-language-assets.mjs",
    "conversation:evaluate": "node scripts/conversation/evaluate-fresh-conversation.mjs",
    "mother:ingest": "node scripts/conversation/ingest-mother-conversations.mjs --check",
    "mother:inventory": "node scripts/conversation/inventory-mother-conversations.mjs",
    "mother:evaluate": "node scripts/conversation/evaluate-mother-conversations.mjs",
    "mother:labels": "node scripts/conversation/analyze-mother-labels.mjs",
    "investigation:evaluate": "node scripts/conversation/evaluate-investigation07.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@huggingface/transformers": "3.8.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
